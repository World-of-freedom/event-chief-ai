VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
# Prefer the current publishable key from the Supabase Connect dialog.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Supported naming alias when your provider config uses SUPABASE_KEY.
# VITE_SUPABASE_KEY=sb_publishable_your-key
# Optional legacy fallback. Do not set more than one key variable.
# VITE_SUPABASE_ANON_KEY=your-anon-key
