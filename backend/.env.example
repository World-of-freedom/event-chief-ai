# HTTPS project URL only. Do not put a postgresql:// URL in this setting.
SUPABASE_URL=https://your-project.supabase.co
# A publishable key may verify an existing bearer token in this scaffold.
# It is safe for frontend use, but cannot perform server-side administration.
SUPABASE_KEY=sb_publishable_your-key
# Add this server-only key before implementing Supabase admin/data operations.
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Server-only Postgres connection string for Alembic and SQLAlchemy. The
# SUPABASE_CONNECTION_STRING name is supported directly; DATABASE_URL is an
# equivalent preferred-generic alias. Set exactly one, never either in Vite.
SUPABASE_CONNECTION_STRING=postgresql+psycopg://postgres:database-password@db.project-ref.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql+psycopg://postgres:database-password@db.project-ref.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_PASSWORD is not read separately: percent-encode it inside the URL.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Event Chief AI <sponsors@example.com>
BOLNA_API_KEY=server-only-bolna-key
BOLNA_AGENT_ID=agent-id
BOLNA_WEBHOOK_SECRET=long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development
