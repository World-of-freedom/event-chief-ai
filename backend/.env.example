# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Use the Supabase auth key from the project dashboard: service role or publishable/anon only.
# Do not set the PostgreSQL connection string here.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# SUPABASE_ANON_KEY=your-anon-key

SUPABASE_CONNECTION_STRING=postgresql+psycopg://postgres:password@db.ref.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql+psycopg://...          # equivalent alias

# ── Email / Voice ─────────────────────────────────────────────────────────────
# Resend is the preferred MVP sender. This one shared address sends all organizer emails.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Event Chief AI <onboarding@resend.dev>
# Free test mode: every approved email is redirected to this one inbox.
RESEND_TEST_MODE=true
RESEND_TEST_RECIPIENT=sumitscience2017@gmail.com
# To deliver to real sponsors later, verify a domain and use:
# RESEND_FROM_EMAIL=Event Chief AI <outreach@your-verified-domain.com>
# RESEND_TEST_MODE=false
# Optional Gmail alternative. Set EMAIL_PROVIDER=gmail to use it.
# GMAIL_SENDER_EMAIL=sumitscience2017@gmail.com
# GMAIL_APP_PASSWORD=your-16-digit-app-password
BOLNA_API_KEY=server-only-bolna-key
BOLNA_AGENT_ID=agent-id
# Optional when the selected agent has more than one outbound caller ID.
BOLNA_FROM_PHONE_NUMBER=+919876543210
BOLNA_WEBHOOK_SECRET=long-random-secret
WORKER_POLL_INTERVAL=10
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development

# ── Sponsor Discovery: LLM ────────────────────────────────────────────────────
# LLM_PROVIDER controls which provider is used: gemini | openai | anthropic
# Only the matching API key is required.
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash-lite   # override the provider default model

GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Sponsor Discovery: Search APIs ───────────────────────────────────────────
# Tavily — primary web research (1,000 credits/month free, no credit card needed)
TAVILY_API_KEY=tvly-your-key
# Brave Search — fallback (optional, $5/month free credit)
# BRAVE_SEARCH_API_KEY=BSA-your-key

# ── Sponsor Discovery: Local Business Discovery ───────────────────────────────
# Google Places API — nearby business search
# Only independently verified company website data is stored (not raw Places responses)
GOOGLE_PLACES_API_KEY=AIza-your-key

# ── Sponsor Discovery: Email Discovery ───────────────────────────────────────
# Hunter.io — organizer-selected email verification (50 credits/month free)
# Discovery itself never calls Hunter or spends credits.
HUNTER_API_KEY=your-hunter-key

# ── Sponsor Discovery: Limits (tunable) ──────────────────────────────────────
# RESEARCH_MAX_SEARCHES=8       # targeted search queries per job
# RESEARCH_MAX_CANDIDATES=30    # max distinct candidate companies to retain
# RESEARCH_MAX_VERIFIED=15      # max candidates to deep-verify
# RESEARCH_MAX_TARGETED_SEARCHES=12  # bounded official-site research queries per job
# RESEARCH_PHONE_DEFAULT_REGION=IN   # used only when a sourced phone lacks a country code
