# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Use the Supabase auth key from the project dashboard: service role or publishable/anon only.
# Do not set the PostgreSQL connection string here.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# SUPABASE_ANON_KEY=your-anon-key

SUPABASE_CONNECTION_STRING=postgresql+psycopg://postgres:password@db.ref.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql+psycopg://...          # equivalent alias

# ── Email / Voice ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Event Chief AI <sponsors@example.com>
BOLNA_API_KEY=server-only-bolna-key
BOLNA_AGENT_ID=agent-id
BOLNA_WEBHOOK_SECRET=long-random-secret

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development

# ── Sponsor Discovery: LLM ────────────────────────────────────────────────────
# LLM_PROVIDER controls which provider is used: gemini | openai | anthropic
# Only the matching API key is required.
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash-lite   # override the provider default model

GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Sponsor Discovery: Search APIs ───────────────────────────────────────────
# Tavily — primary web research (1,000 credits/month free, no credit card needed)
TAVILY_API_KEY=tvly-your-key
# Brave Search — fallback (optional, $5/month free credit)
# BRAVE_SEARCH_API_KEY=BSA-your-key

# ── Sponsor Discovery: Local Business Discovery ───────────────────────────────
# Google Places API — nearby business search
# Only independently verified company website data is stored (not raw Places responses)
GOOGLE_PLACES_API_KEY=AIza-your-key

# ── Sponsor Discovery: Email Discovery ───────────────────────────────────────
# Hunter.io — email discovery and verification (50 credits/month free)
HUNTER_API_KEY=your-hunter-key

# ── Sponsor Discovery: Limits (tunable) ──────────────────────────────────────
# RESEARCH_MAX_SEARCHES=8       # targeted search queries per job
# RESEARCH_MAX_CANDIDATES=30    # max distinct candidate companies to retain
# RESEARCH_MAX_VERIFIED=15      # max candidates to deep-verify
